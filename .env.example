# DATABASE_URL=postgresql://...
# SYMB_INDEXER_START_BLOCK=12345
# SYMB_INDEXER_BATCH_SIZE=50
# SYMB_INDEXER_CONFIRMATIONS=12
# SYMB_INDEXER_MAX_WINDOWS=1
# Do not put DATABASE_URL or secrets into NEXT_PUBLIC_* variables.
