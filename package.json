{
  "name": "symb-dex",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:rpc": "node scripts/check-rpc.mjs",
    "index:liquidity": "node scripts/index-liquidity.mjs",
    "index:market": "node scripts/index-market.mjs",
    "reconcile:market": "node scripts/reconcile-market.mjs",
    "contracts:build": "forge build --sizes contracts/src",
    "contracts:test": "forge test -vv",
    "inspect:wvery": "node scripts/inspect-wvery.mjs",
    "beta:preflight": "node scripts/beta-preflight.mjs",
    "beta:gate:ci": "node scripts/beta-preflight.mjs --assert-closed",
    "testnet:verify": "node scripts/configure-testnet.mjs --verify-only",
    "testnet:configure": "node scripts/configure-testnet.mjs",
    "index:testnet": "node scripts/index-testnet.mjs",
    "reconcile:testnet": "node scripts/reconcile-testnet.mjs",
    "smoke:testnet": "node scripts/smoke-testnet.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.38.0",
    "wagmi": "^2.19.0",
    "@neondatabase/serverless": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
